# DroneDash CLE (CLE_DDOS) — Environment Configuration Template
# ==============================================================
# Copy this file to .env and configure local values.
# NEVER commit .env to version control!

# Application Environment (dev | prod)
# - In 'dev': Enables demo persona bypass switchers for local evaluator grading
# - In 'prod': Disables demo bypass routes and locks down OpenAPI docs
ENVIRONMENT=dev

# Application Secret Key (Used for cryptographic HMAC-SHA256 session cookie signing)
# Generate a secure key with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production-to-a-random-32-byte-hex-string

# Server Network Binding
# Always bind to 127.0.0.1 for Cloudflare Tunnel ingress security
HOST=127.0.0.1
PORT=8000

# Google OAuth 2.0 Credentials (Optional in dev mode, required for real Google SSO)
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Admin & Dispatcher Role Whitelist
# Comma-separated list of Google account emails automatically granted Dispatcher/Admin privileges
ADMIN_EMAILS=admin@dronedash.cle,dispatcher@dronedash.cle

# Database Configuration
DATABASE_URL=sqlite:///./dronedash.db

# Cloudflare Tunnel Configuration (Optional, for named tunnel mode)
# CLOUDFLARE_TUNNEL_TOKEN=
