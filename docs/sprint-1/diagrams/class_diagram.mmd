classDiagram
    direction TB

    class Customer {
        +String customerId
        +String name
        +String email
        +String phone
        +registerAddress(address: DeliveryAddress)
        +placeOrder(order: DeliveryOrder)
        +getOrderHistory() List~DeliveryOrder~
    }

    class DeliveryAddress {
        +String addressId
        +String street
        +String city
        +String state
        +String zipCode
        +Double latitude
        +Double longitude
        +distanceTo(other: DeliveryAddress) Double
    }

    class DeliveryOrder {
        +String orderId
        +String priority
        +DateTime requestedTime
        +String status
        +DateTime createdAt
        +assignDrone(drone: Drone) Boolean
        +transitionStatus(newStatus: String) Boolean
        +cancelOrder() Boolean
        +markReschedulingRequired()
    }

    class Package {
        +String packageId
        +Double weightLbs
        +Double lengthIn
        +Double widthIn
        +Double heightIn
        +String packageType
        +String specialHandling
        +fitsCapacity(maxWeight: Double) Boolean
    }

    class Drone {
        +String droneId
        +String model
        +Double maxPayloadLbs
        +Double maxFlightRangeMiles
        +Double batteryLevelPct
        +String status
        +Double currentLat
        +Double currentLon
        +Double consumptionRatePerMile
        +isEligible(pkg: Package, distance: Double) Boolean
        +updateTelemetry(lat: Double, lon: Double, battery: Double)
        +dockAt(station: DroneStation)
    }

    class DroneStation {
        +String stationId
        +String name
        +Double latitude
        +Double longitude
        +Integer dockCapacity
        +Integer availableDocks
        +hasAvailableDock() Boolean
        +dockDrone(drone: Drone)
        +releaseDrone(drone: Drone)
    }

    class DeliveryZone {
        +String zoneId
        +String name
        +String zoneType
        +containsPoint(lat: Double, lon: Double) Boolean
    }

    class AirspaceRestriction {
        +String restrictionId
        +String restrictionType
        +Boolean isActive
        +String reason
        +DateTime startTime
        +DateTime endTime
        +isRestricting(lat: Double, lon: Double) Boolean
    }

    class Flight {
        +String flightId
        +DateTime departureTime
        +DateTime arrivalTime
        +Double batteryConsumedPct
        +String flightStatus
        +recordDeparture()
        +recordArrival()
        +logAbort(reason: String)
    }

    class DeliveryRecord {
        +String recordId
        +DateTime completionTime
        +String finalStatus
        +Double totalDistanceMiles
        +archive()
    }

    class DeliveryException {
        +String exceptionId
        +String exceptionType
        +DateTime timestamp
        +String resolutionAction
        +String technicianNotes
        +applyResolution(action: String)
    }

    class MaintenanceRecord {
        +String recordId
        +DateTime startTime
        +DateTime endTime
        +String technicianNotes
        +String workPerformed
        +completeMaintenance(releaseStatus: String)
    }

    %% Relationships & Multiplicities
    Customer "1" *-- "1..*" DeliveryAddress : owns
    Customer "1" *-- "0..*" DeliveryOrder : places
    DeliveryOrder "1" *-- "1" Package : contains
    DeliveryOrder "1" --> "1" DeliveryAddress : pickupLocation
    DeliveryOrder "1" --> "1" DeliveryAddress : destinationLocation
    DeliveryOrder "0..1" <--> "0..1" Drone : assigned
    DroneStation "1" o-- "0..*" Drone : docks
    DeliveryOrder "1" *-- "0..1" Flight : generates
    DeliveryOrder "1" *-- "0..1" DeliveryRecord : preserves
    DeliveryOrder "1" *-- "0..*" DeliveryException : incurs
    Drone "1" *-- "0..*" MaintenanceRecord : logs
    DeliveryZone "1" *-- "0..*" AirspaceRestriction : governs
    Flight "0..1" --> "1" DroneStation : recoveryStation
