flowchart LR
    %% Actors
    subgraph Actors [Actors]
        direction TB
        C["Customer"]
        D["Dispatcher / Operations Admin"]
        M["Maintenance Technician"]
        A["Airspace Authority / FAA"]
    end

    %% CLE_DDOS Boundary
    subgraph SystemBoundary ["Drone Delivery Operations System (CLE_DDOS)"]
        direction TB

        %% Customer Use Cases
        subgraph CustomerPortal ["Customer Order Management"]
            UC1(["UC-01: Register Account & Delivery Addresses"])
            UC2(["UC-02: Submit Package Delivery Order"])
            UC3(["UC-03: Track Real-Time Delivery Status"])
            UC4(["UC-04: View Historical Delivery Records"])
            UC5(["UC-05: Cancel Order (Pre-Transit)"])
        end

        %% Scheduling & Flight Management
        subgraph OperationsManagement ["Fleet & Delivery Operations"]
            UC6(["UC-06: Schedule Delivery & Assign Drone"])
            UC7(["UC-07: Monitor Live Flight Telemetry"])
            UC8(["UC-08: Confirm Package Delivery Drop"])
            UC9(["UC-09: Reassign / Reschedule Delivery Order"])
            UC10(["UC-10: Generate Operational Audit Reports"])
        end

        %% Sub-use-cases (Included / Extended)
        subgraph ConstraintsChecks ["Core System Validations"]
            UC_VAL(["<<include>> Validate Package, Range & 20% Battery"])
            UC_ZONE(["<<include>> Verify Airspace Zone Restrictions"])
            UC_EXC(["<<extend>> Handle In-Flight Exception & Trigger RTB Abort"])
        end

        %% Airspace & Maintenance
        subgraph AdminAndTech ["Airspace & Maintenance"]
            UC11(["UC-11: Define & Update Delivery Zones / Restrictions"])
            UC12(["UC-12: Flag Drone for Maintenance"])
            UC13(["UC-13: Log Maintenance Work & Release to Available"])
        end
    end

    %% Actor Relationships
    C --> UC1
    C --> UC2
    C --> UC3
    C --> UC4
    C --> UC5

    D --> UC6
    D --> UC7
    D --> UC8
    D --> UC9
    D --> UC10
    D --> UC11

    M --> UC12
    M --> UC13

    A --> UC11

    %% Includes & Extends
    UC6 -.->|<<include>>| UC_VAL
    UC6 -.->|<<include>>| UC_ZONE
    UC7 -.->|<<extend>>| UC_EXC
    UC_EXC -.->|triggers| UC9
